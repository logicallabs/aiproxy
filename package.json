{
  "name": "aiproxy",
  "type": "module",
  "version": "1.0.0",
  "description": "Reverse proxy for submitting AI prompts",
  "main": "server.cjs",
  "scripts": {
    "start": "node server.cjs",
    "start:dev": "bash start.sh",
    "worker:dev": "bash scripts/worker.sh dev",
    "worker:deploy": "bash scripts/worker.sh deploy dev",
    "worker:deploy:prod": "bash scripts/worker.sh deploy production",
    "test": "node --test test/unit.test.js",
    "test:live": "node --test test/test.js",
    "test:all": "node --test test/unit.test.js test/test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
